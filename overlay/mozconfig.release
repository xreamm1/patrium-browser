# Patrium release build: PGO + cross-language ThinLTO.
# Usage (MozillaBuild shell): MOZCONFIG=mozconfig.release ./mach build
. "$topsrcdir/mozconfig"

ac_add_options --enable-release
ac_add_options --enable-lto=cross
export MOZ_PGO=1

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-patrium-release

# 16 GB RAM: fewer parallel compile jobs and ThinLTO backend threads so the
# final xul.dll link does not run out of memory.
mk_add_options MOZ_PARALLEL_BUILD=4
export LDFLAGS="$LDFLAGS /opt:lldltojobs=4"
export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
